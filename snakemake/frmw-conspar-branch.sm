	input:
#		dnd=get_hi_dnd,
		dnd="dnd/{seqs}.proba.slmin.dnd",
		ssfiles="ss/{seqs}.proba.ss",
		cl=f"cons/{seqs}.cl",
		in_tfa=f"input/{seqs}.in_tfa"
	output:
		"alncons/{seqs}.proba.slmin.cons.msf"
	priority: 100
	threads: 3
#	params:
#		gtopt = lambda wildcards: wildcards.gtshi
	shell:
		"""
		if [ ! -f alncons/{seqs}.proba.slmin.cons.in_tfa ]; then ln -s ../input/{seqs}.in_tfa alncons/{seqs}.proba.slmin.cons.in_tfa; fi
		echo "aligncons-slmin-proba" > output/{seqs}.proba.slmin.cons.msf.date
		date -Ins >> output/{seqs}.proba.slmin.cons.msf.date
		{frmw_aligncons} -ALIGN -CLUSTERING=SLMIN -INFILE=alncons/{seqs}.proba.slmin.cons.in_tfa -SSFILE=ss/{seqs}.proba.ss -USETREE=dnd/{seqs}.proba.slmin.dnd -CLFILE=cons/{seqs}.cl -MAXDIV=0 -OUTPUT=GCG > output/{seqs}.proba.slmin.cons.msf.out
		date -Ins >> output/{seqs}.proba.slmin.cons.msf.date
		"""

