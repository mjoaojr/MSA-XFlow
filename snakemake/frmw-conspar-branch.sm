rule alignconsupgma:
	input:
#		dnd=get_hi_dnd,
		dnd="dnd/{seqs}.proba.upgma.dnd",
		ssfiles="ss/{seqs}.proba.ss",
		cl=f"cons/{seqs}.cl",
		in_tfa=f"input/{seqs}.in_tfa"
	output:
		"alncons/{seqs}.proba.upgma.cons.msf"
	priority: 100
	threads: 3
#	params:
#		gtopt = lambda wildcards: wildcards.gtshi
	shell:
		"""
		if [ ! -f alncons/{seqs}.proba.upgma.cons.in_tfa ]; then ln -s ../input/{seqs}.in_tfa alncons/{seqs}.proba.upgma.cons.in_tfa; fi
		echo "aligncons-upgma-proba" > output/{seqs}.proba.upgma.cons.msf.date
		date -Ins >> output/{seqs}.proba.upgma.cons.msf.date
		{frmw_aligncons} -ALIGN -CLUSTERING=UPGMA -INFILE=alncons/{seqs}.proba.upgma.cons.in_tfa -SSFILE=ss/{seqs}.proba.ss -USETREE=dnd/{seqs}.proba.upgma.dnd -CLFILE=cons/{seqs}.cl -MAXDIV=0 -OUTPUT=GCG > output/{seqs}.proba.upgma.cons.msf.out
		date -Ins >> output/{seqs}.proba.upgma.cons.msf.date
		"""

